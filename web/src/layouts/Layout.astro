---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Muhūrta • Sanatan Astrodynamics & Sacred Chronometry",
  description = "Non-commercial, open-source Vedic calendar & astronomical ephemeris application for iOS. Sunrise-to-sunrise reckoning, live Doshic circadian rhythms, and 30 sacred Muhūrtas."
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080C" />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://muhurta.shindeaditya.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://muhurta.shindeaditya.com/app-icon.png" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content="https://muhurta.shindeaditya.com/app-icon.png" />
  </head>
  <body>
    <!-- Top Navigation Header -->
    <header class="site-header">
      <div class="container header-container">
        <a href="/" class="brand-link">
          <img src="/favicon.png" alt="Muhūrta Logo" class="brand-icon-img" />
          <div class="brand-text">
            <span class="brand-title">Muhūrta</span>
            <span class="brand-subtitle">काल-विज्ञान</span>
          </div>
        </a>

        <nav class="nav-links">
          <a href="/#features" class="nav-item">Features</a>
          <a href="/#philosophy" class="nav-item">Sanatan Astro</a>
          <a href="/support" class="nav-item">Support & Seva</a>
          <a href="/privacy" class="nav-item">Privacy</a>
          <a href="/terms" class="nav-item">Terms</a>
        </nav>

        <div class="header-actions">
          <a href="https://github.com/heyshinde/Muhurta" target="_blank" rel="noopener noreferrer" class="github-btn" title="Open Source Repository">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <div class="brand-row">
            <span class="footer-om">ॐ</span>
            <span class="footer-title">Muhūrta (मुहूर्त)</span>
          </div>
          <p class="footer-desc">
            An independent, non-commercial Vedic ephemeris and sacred chronometry sanctuary. 
            Crafted for seekers, astronomers, and sādhakas worldwide. Licensed under GNU GPLv3.
          </p>
        </div>

        <div class="footer-columns">
          <div class="footer-col">
            <h4>Sanatan Wisdom</h4>
            <a href="/#features">Sūryodaya Reckoning</a>
            <a href="/#features">30 Vedic Muhūrtas</a>
            <a href="/#features">Circadian Nidrā Vijñāna</a>
            <a href="/#features">Panchānga & Choghadiya</a>
          </div>

          <div class="footer-col">
            <h4>App & Transparency</h4>
            <a href="/support">Support & FAQ</a>
            <a href="/privacy">Privacy Sanctuary (Zero Ads)</a>
            <a href="/terms">Terms of Service</a>
            <a href="https://github.com/heyshinde/Muhurta" target="_blank" rel="noopener noreferrer">Source Code (GitHub)</a>
          </div>
        </div>
      </div>

      <div class="container footer-bottom">
        <p>© {currentYear} Aditya Shinde & The Muhūrta Contributors. Free, Open & Without Ads Forever.</p>
        <p class="mantra-line">ॐ असतो मा सद्गमय । तमसो मा ज्योतिर्गमय । मृत्योर्मा अमृतं गमय ॥</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(7, 8, 12, 0.75);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-icon-img {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    box-shadow: 0 0 14px rgba(244, 194, 106, 0.25);
    border: 1px solid rgba(244, 194, 106, 0.3);
  }

  .brand-om {
    font-size: 1.7rem;
    color: var(--gold-primary);
    line-height: 1;
    text-shadow: 0 0 16px rgba(244, 194, 106, 0.4);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .brand-subtitle {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--gold-primary);
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--gold-primary);
  }

  .github-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .github-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--gold-primary);
    color: var(--gold-primary);
  }

  .main-content {
    flex: 1;
  }

  .site-footer {
    background: #050608;
    border-top: 1px solid var(--border-subtle);
    padding: 64px 0 32px;
    margin-top: 80px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-brand .brand-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .footer-om {
    font-size: 1.5rem;
    color: var(--gold-primary);
  }

  .footer-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 380px;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .footer-col h4 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 16px;
  }

  .footer-col a {
    display: block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 10px;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #ffffff;
    transform: translateX(2px);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .mantra-line {
    font-family: var(--font-serif);
    color: var(--gold-primary);
    opacity: 0.7;
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .footer-content {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .footer-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
