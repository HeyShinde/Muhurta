---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Muhūrta • Sacred Vedic Chronometry & Solar Ephemeris"
  description="Experience time as cosmic rhythm. An open-source, non-commercial Vedic calendar and astronomical ephemeris application for iOS. 100% Free, Private, and Ad-Free."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Open-Source Sanatan Astrodynamics • GNU GPLv3</span>
      </div>

      <h1 class="hero-title">
        Experience Time as <br/>
        <span class="gold-gradient-text">Sacred Cosmic Rhythm</span>
      </h1>

      <p class="hero-subtitle">
        Muhūrta calculates exact local astronomical coordinates to liberate your daily life from arbitrary midnight clocks. 
        Synchronize your breath, meals, work, and sleep with true solar arc physics and timeless Vedic chronometry.
      </p>

      <div class="hero-actions">
        <a href="#download" class="btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.8c.61-.74 1.02-1.78.91-2.8-.88.04-1.95.59-2.58 1.33-.56.64-.99 1.68-.86 2.69.98.08 1.98-.51 2.53-1.22z"/>
          </svg>
          <span>Download on iOS</span>
        </a>

        <a href="https://github.com/heyshinde/Muhurta" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Inspect Source (GitHub)</span>
        </a>
      </div>

      <!-- Ephemeris Highlight Pill -->
      <div class="ephemeris-strip glass-panel">
        <div class="strip-item">
          <span class="strip-label">Epoch</span>
          <span class="strip-val">Kali Yuga 5,128</span>
        </div>
        <div class="strip-sep"></div>
        <div class="strip-item">
          <span class="strip-label">Ephemeris Base</span>
          <span class="strip-val">Ujjain Coordinate Zero</span>
        </div>
        <div class="strip-sep"></div>
        <div class="strip-item">
          <span class="strip-label">Ayanāṁśa</span>
          <span class="strip-val">True Chitra-Paksha (Lahiri)</span>
        </div>
        <div class="strip-sep"></div>
        <div class="strip-item">
          <span class="strip-label">Ad Policy</span>
          <span class="strip-val" style="color: var(--gold-primary);">100% Ad-Free Forever</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Pillars Section -->
  <section id="features" class="features-section">
    <div class="container">
      <div class="section-header">
        <span class="badge-gold">FOUR SACRED PILLARS</span>
        <h2>Precision Astrodynamics for Sādhana</h2>
        <p class="section-desc">
          Merging classical Sūryasiddhāntic mathematics with high-performance Swift 6 astronomical algorithms.
        </p>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon">🌅</div>
          <h3>Sūryodaya Diurnal Reckoning</h3>
          <p>
            The Vedic day begins at true astronomical sunrise, not arbitrary mechanical midnight. 
            All Tithis, Dinacharyā routines, and sacred fasts align with the actual solar illumination curve of your exact coordinates.
          </p>
          <ul class="feature-points">
            <li>True solar noon (Madhyāhna) calculation</li>
            <li>Dynamic day and night duration scaling</li>
            <li>Sandhyā twilight transition alerts</li>
          </ul>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon">⏱️</div>
          <h3>The 30 Sacred Muhūrtas</h3>
          <p>
            Every 24-hour cycle is apportioned into 30 distinct energetic windows (15 diurnal, 15 nocturnal). 
            Identify Brahma Muhūrta for meditation, Abhijit for auspicious undertakings, and avoid Rāhukāla disturbances.
          </p>
          <ul class="feature-points">
            <li>Live countdown to active Muhūrta window</li>
            <li>Benefic (Śubha) & malefic (Aśubha) classifications</li>
            <li>Day and Night Choghadiya intervals</li>
          </ul>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon">🌙</div>
          <h3>Circadian Nidrā & Agni Vijñāna</h3>
          <p>
            Align your sleep and nutrition with natural doshic biological cycles. 
            Follow Ayurvedic wisdom through Kapha tranquility, Pitta cellular rejuvenation, and Vāta awakening phases.
          </p>
          <ul class="feature-points">
            <li>Peak Solar Agni & optimal meal timings</li>
            <li>Vāmakukṣi (left-side) restorative rest posture</li>
            <li>Vāstu-aligned sleep directions (South & East)</li>
          </ul>
        </div>

        <!-- Feature 4 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon">🌺</div>
          <h3>Sankalpa & Sacred Milestones</h3>
          <p>
            Track birthdays, anniversaries, and sacred Saṁskāras according to your Vedic Tithi and Nakṣatra recurrence, 
            rather than the Gregorian calendar alone.
          </p>
          <ul class="feature-points">
            <li>50+ milestone capacity with full search & filtering</li>
            <li>Automated recurring Tithi calculation engine</li>
            <li>Private, on-device iCloud synchronization</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source & Philosophy Section -->
  <section id="philosophy" class="philosophy-section">
    <div class="container">
      <div class="philosophy-box glass-panel">
        <div class="philosophy-content">
          <span class="badge-gold">OPEN RESEARCH & SEVA</span>
          <h2>Wisdom Belongs to All Seekers</h2>
          <p>
            Muhūrta is built as a non-commercial offering. We believe that sacred astronomical algorithms, 
            ephemeris mathematics, and circadian health insights should never be locked behind paywalls or tainted with commercial ads.
          </p>
          <p>
            Every formula used to calculate planetary positions, solar declinations, sunrise equation of time, 
            and lunar tithis is completely open-source under the <strong>GNU General Public License v3.0 (GPLv3)</strong>.
          </p>

          <div class="philosophy-actions">
            <a href="https://github.com/heyshinde/Muhurta" target="_blank" rel="noopener noreferrer" class="btn-primary">
              Contribute on GitHub
            </a>
            <a href="/support" class="btn-secondary">
              Voluntary Dakṣiṇā & Support
            </a>
          </div>
        </div>

        <div class="philosophy-stats">
          <div class="stat-card">
            <span class="stat-num">0</span>
            <span class="stat-label">Advertisements & Trackers</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">100%</span>
            <span class="stat-label">Open Source (Swift 6)</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">0 ms</span>
            <span class="stat-label">Cloud Latency (Local Math)</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">GPLv3</span>
            <span class="stat-label">Free Software License</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="download" class="cta-section">
    <div class="container cta-container">
      <span class="cta-om">ॐ</span>
      <h2>Begin Your Journey in Sacred Time</h2>
      <p>
        Available on the App Store for iPhone and iPad. Free, private, and consecrated for your daily spiritual practice.
      </p>
      <div class="cta-actions">
        <a href="https://apps.apple.com" target="_blank" rel="noopener noreferrer" class="btn-primary">
          <span>Get Muhūrta on the App Store</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding: 100px 0 60px;
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(244, 194, 106, 0.08);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--gold-primary);
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-primary);
    box-shadow: 0 0 8px var(--gold-primary);
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    margin-bottom: 24px;
    max-width: 820px;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .ephemeris-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 18px 32px;
    width: 100%;
    max-width: 900px;
    background: rgba(14, 16, 26, 0.6);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .strip-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .strip-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
  }

  .strip-sep {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  /* Features */
  .features-section {
    padding: 90px 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .section-header h2 {
    font-size: 2.4rem;
    margin-top: 14px;
    margin-bottom: 12px;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .feature-card {
    padding: 36px;
  }

  .feature-icon {
    font-size: 2.2rem;
    margin-bottom: 18px;
  }

  .feature-card h3 {
    font-size: 1.35rem;
    margin-bottom: 12px;
    color: #ffffff;
  }

  .feature-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .feature-points {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature-points li {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .feature-points li::before {
    content: "•";
    color: var(--gold-primary);
    font-weight: bold;
  }

  /* Philosophy */
  .philosophy-section {
    padding: 80px 0;
  }

  .philosophy-box {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    padding: 56px;
    align-items: center;
  }

  .philosophy-content h2 {
    font-size: 2.2rem;
    margin-top: 14px;
    margin-bottom: 18px;
  }

  .philosophy-content p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .philosophy-actions {
    display: flex;
    gap: 14px;
    margin-top: 28px;
  }

  .philosophy-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--gold-primary);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* CTA */
  .cta-section {
    padding: 100px 0;
    text-align: center;
  }

  .cta-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-om {
    font-size: 3rem;
    color: var(--gold-primary);
    margin-bottom: 16px;
    text-shadow: 0 0 24px var(--gold-glow);
  }

  .cta-section h2 {
    font-size: 2.6rem;
    margin-bottom: 16px;
  }

  .cta-section p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 580px;
    margin-bottom: 32px;
  }

  @media (max-width: 840px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .ephemeris-strip {
      flex-direction: column;
      gap: 14px;
    }
    .strip-sep {
      display: none;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
    .philosophy-box {
      grid-template-columns: 1fr;
      padding: 32px;
    }
    .philosophy-stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
